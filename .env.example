# Extraction provider: "mock" (default, no keys) or "sarvam-docai" (stretch, requires a key).
EXTRACTION_PROVIDER=mock

# Sarvam Doc AI (only used when EXTRACTION_PROVIDER=sarvam-docai). Never commit a real key.
# SARVAM_API_KEY=
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_POLL_MS=1500

# --- Feature flags (readable on client; toggle per deployment) ---
# Show the internal Diagnostics panel in the job console (default: on).
NEXT_PUBLIC_FEATURE_DIAGNOSTICS=true
# Allow editing + approving fields in review; when false, review is read-only (default: on).
NEXT_PUBLIC_FEATURE_REVIEW_EDITING=true
# Run the guided product walkthrough (spotlight tour) on home + job console (default: on).
NEXT_PUBLIC_FEATURE_WALKTHROUGH=true
