# Extraction provider: "mock" (default, no keys) or "docai" (stretch, requires a key).
EXTRACTION_PROVIDER=mock

# document AI (only used when EXTRACTION_PROVIDER=docai). Never commit a real key.
# DOCAI_API_KEY=
# DOCAI_BASE_URL=
# DOCAI_POLL_MS=1500

# --- Feature flags (readable on client; toggle per deployment) ---
# Show the internal Diagnostics panel in the job console (default: on).
NEXT_PUBLIC_FEATURE_DIAGNOSTICS=true
# Allow editing + approving fields in review; when false, review is read-only (default: on).
NEXT_PUBLIC_FEATURE_REVIEW_EDITING=true
# Run the guided product walkthrough (spotlight tour) on home + job console (default: on).
NEXT_PUBLIC_FEATURE_WALKTHROUGH=true

# --- Data root (uploads + SQLite job store) ---
# Override the data directory. Default: `.data` locally, `/tmp` on Vercel.
# DATA_DIR=

# Persist jobs/events/reviews to SQLite (default: on). Set false for an in-memory store.
# NODE_ENV=test also forces in-memory.
# FEATURE_DURABLE_STORE=true

# On-screen perf HUD (pages/rows mounted, polls, SSE applies, heap, rendering budget).
# NEXT_PUBLIC_PERF_HUD=true
# Label shown on the HUD: current | naive | enhanced
# NEXT_PUBLIC_PERF_TREATMENT=current
